	<munit:test name="one-failing-retry-does-not-stop-the-others" description="An error on one row is logged and the next row is still tried">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Get unsent notifications" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[[{id: 1, applicationId: 'APP-2026-000001', template: 'APPROVED', round: 1, status: 'RETRYING', attempts: 1, ageSeconds: 10}, {id: 2, applicationId: 'APP-2026-000002', template: 'DECLINED', round: 1, status: 'RETRYING', attempts: 2, ageSeconds: 29}, {id: 3, applicationId: 'APP-2026-000003', template: 'REFERRED', round: 1, status: 'PENDING', attempts: 0, ageSeconds: 60}, {id: 4, applicationId: 'APP-2026-000004', template: 'APPROVED', round: 1, status: 'PENDING', attempts: 0, ageSeconds: 59}, {id: 5, applicationId: 'APP-2026-000005', template: 'APPROVED', round: 1, status: 'FAILED', attempts: 5, ageSeconds: 9999}]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="mule:flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="sf-retry-one" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="EMAIL:CONNECTIVITY" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[null]" mediaType="application/java" />
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<try doc:name="Try"><flow-ref name="sf-retry-due" /><error-handler><on-error-continue><set-variable value="#[error.errorType.identifier]" variableName="caught" /></on-error-continue></error-handler></try>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::nullValue()]" />
			<munit-tools:verify-call processor="mule:flow-ref" times="2">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="sf-retry-one" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
