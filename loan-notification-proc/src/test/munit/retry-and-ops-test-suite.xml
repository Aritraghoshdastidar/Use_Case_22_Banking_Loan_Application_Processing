	<munit:test name="failed-publish-of-a-json-row-is-still-recorded" description="The row arrives as JSON from the system API. Logging the failure must not trip over mixing that with the error type, or the failure is never recorded">
		<munit:behavior>
			<munit:set-event>
				<munit:payload value="#[output application/json --- {messageId: '11111111-1111-4111-8111-111111111111', queue: 'loan.verify.q', payload: {messageId: '11111111-1111-4111-8111-111111111111', correlationId: '22222222-2222-4222-8222-222222222222', applicationId: 'APP-2026-000001', 'type': 'VERIFY_REQUESTED', attempt: 1}, attempts: 0}]" mediaType="application/json" />
			</munit:set-event>
			<munit-tools:mock-when processor="amqp:publish">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Publish" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="AMQP:PUBLISHING" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark failed" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark sent" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="sf-publish-outbox-row" />
		</munit:execution>
		<munit:validation>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark failed" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="http:request" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark sent" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
