	<munit:test name="only-due-notifications-are-retried" description="Waits grow with each failure (10 s, 30 s, 70 s ...); a fresh PENDING row waits a minute in case its message is still being handled; FAILED rows are left alone">
		<munit:behavior>
			<set-variable value="none" variableName="x" />
			<munit:set-event>
				<munit:payload value="#[[{id: 1, applicationId: 'APP-2026-000001', template: 'APPROVED', round: 1, status: 'RETRYING', attempts: 1, ageSeconds: 10}, {id: 2, applicationId: 'APP-2026-000002', template: 'DECLINED', round: 1, status: 'RETRYING', attempts: 2, ageSeconds: 29}, {id: 3, applicationId: 'APP-2026-000003', template: 'REFERRED', round: 1, status: 'PENDING', attempts: 0, ageSeconds: 60}, {id: 4, applicationId: 'APP-2026-000004', template: 'APPROVED', round: 1, status: 'PENDING', attempts: 0, ageSeconds: 59}, {id: 5, applicationId: 'APP-2026-000005', template: 'APPROVED', round: 1, status: 'FAILED', attempts: 5, ageSeconds: 9999}]]" mediaType="application/java" />
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/due-notifications.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[sizeOf(payload)]" is="#[MunitTools::equalTo(2)]" />
			<munit-tools:assert-that expression="#[payload[0].id]" is="#[MunitTools::equalTo(1)]" />
			<munit-tools:assert-that expression="#[payload[1].id]" is="#[MunitTools::equalTo(3)]" />
		</munit:validation>
	</munit:test>
