	<munit:test name="error-http-connectivity-maps-to-503" description="HTTP:CONNECTIVITY is answered with HTTP 503 and code SERVICE_UNAVAILABLE">
		<munit:behavior>
			<munit-tools:mock-when processor="mule:flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="boom-0" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<try doc:name="Try"><flow-ref name="raise-0" /><error-handler><on-error-continue><set-variable value="#[vars.httpStatus]" variableName="status" /><set-variable value="#[vars.errorCode]" variableName="code" /><set-variable value="#[payload.correlationId default '']" variableName="bodyCorrelation" /><set-variable value="#[payload.message]" variableName="bodyMessage" /></on-error-continue></error-handler></try>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.status as String]" is="#[MunitTools::equalTo('503')]" />
			<munit-tools:assert-that expression="#[vars.code]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]" />
			<munit-tools:assert-that expression="#[vars.bodyMessage]" is="#[MunitTools::equalTo('Request could not be processed')]" />
			<munit-tools:assert-that expression="#[sizeOf(vars.bodyCorrelation) &gt; 0]" is="#[MunitTools::equalTo(true)]" />
		</munit:validation>
	</munit:test>
