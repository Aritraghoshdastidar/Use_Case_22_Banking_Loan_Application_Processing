	</munit:before-test>
	<munit:test name="new-message-is-handled-and-acked" description="A first delivery is claimed, handled and acknowledged">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Claim message" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{claimed: true}]" mediaType="application/java" />
					<munit-tools:attributes value="#[{statusCode: 201}]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="mule:flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="sf-handle-decision" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{applicationId: 'APP-2026-000001', stage: 'DECIDED'}]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="amqp:ack">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Ack" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="amqp:reject">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Reject" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="amqp:publish">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Publish to dead-letter queue" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="sf-consume-message" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.outcome]" is="#[MunitTools::equalTo('DONE')]" />
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Claim message" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="mule:flow-ref" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="sf-handle-decision" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="amqp:ack" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Ack" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="amqp:publish" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Publish to dead-letter queue" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="amqp:reject" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Reject" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
