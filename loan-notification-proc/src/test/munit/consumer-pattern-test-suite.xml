		<munit:validation>
			<munit-tools:assert-that expression="#[vars.outcome]" is="#[MunitTools::equalTo('EXHAUSTED')]" />
			<munit-tools:assert-that expression="#[vars.attempt]" is="#[MunitTools::equalTo(4)]" />
			<munit-tools:verify-call processor="http:request" times="1">
