	<munit:test name="temporary-failure-is-retried-then-dead-lettered" description="A system API that stays down is tried once and retried three times, then the message is dead-lettered">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Claim message" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
