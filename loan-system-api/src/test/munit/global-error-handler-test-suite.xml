	<munit:test name="error-apikit-bad-request-maps-to-400" description="APIKIT:BAD_REQUEST is answered with HTTP 400 and code BAD_REQUEST">
		<munit:behavior>
			<munit-tools:mock-when processor="mule:flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="boom-0" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="APIKIT:BAD_REQUEST" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<try doc:name="Try"><flow-ref name="raise-0" /><error-handler><on-error-continue><set-variable value="#[vars.httpStatus]" variableName="status" /><set-variable value="#[vars.errorCode]" variableName="code" /></on-error-continue></error-handler></try>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.status as String]" is="#[MunitTools::equalTo('400')]" />
			<munit-tools:assert-that expression="#[vars.code]" is="#[MunitTools::equalTo('BAD_REQUEST')]" />
		</munit:validation>
	</munit:test>
