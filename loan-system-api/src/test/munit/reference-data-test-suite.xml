					<munit-tools:with-attribute attributeName="doc:name" whereValue="Get active scorecard" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[[]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="get:\scorecards\active:loan-system-api-config" />
		</munit:execution>
	</munit:test>
	<munit:test name="list-applications-returns-age-and-amount" description="List gives id, amount and age for the digest">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Get applications" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[[{application_id: 'APP-2026-000001', product_code: 'PL', requested_amount: 200000, stage: 'REFERRED', stage_reason: 'DATA_UNAVAILABLE', created_epoch: 1762300000}]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{queryParams: {stage: 'REFERRED', limit: '10'}}]" />
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="get:\applications:loan-system-api-config" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[sizeOf(payload)]" is="#[MunitTools::equalTo(1)]" />
			<munit-tools:assert-that expression="#[payload[0].stage]" is="#[MunitTools::equalTo('REFERRED')]" />
			<munit-tools:assert-that expression="#[payload[0].ageMinutes &gt; 0]" is="#[MunitTools::equalTo(true)]" />
		</munit:validation>
	</munit:test>
</mule>
