	<munit:test name="failed-inventory-save-keeps-the-staging-copy" description="If the inventory cannot be saved the staging file is not deleted, so the whole step can run again">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001'}]" variableName="app" />
			<set-variable value="#[{results: [{key: 'staging/f/p2.pdf', fileName: 'p2.pdf', docType: 'PAYSLIP', size: 100, status: 'QUARANTINED', reason: 'FILE_TOO_LARGE', sha256: null}], quarantined: [{key: 'staging/f/p2.pdf', fileName: 'p2.pdf', docType: 'PAYSLIP', size: 100, status: 'QUARANTINED', reason: 'FILE_TOO_LARGE', sha256: null}]}]" variableName="validation" />
			<munit-tools:mock-when processor="s3:copy-object">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Copy to quarantine" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="s3:delete-object">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Remove from staging" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Save inventory" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<try doc:name="Try"><flow-ref name="sf-store-results" /><error-handler><on-error-continue><set-variable value="#[error.errorType.identifier]" variableName="caught" /></on-error-continue></error-handler></try>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::equalTo('CONNECTIVITY')]" />
			<munit-tools:verify-call processor="s3:delete-object" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Remove from staging" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
	<munit:test name="nothing-to-validate-skips-the-parallel-step" description="When every file was accepted before, no file is checked again">
		<munit:behavior>
			<set-variable value="#[{rules: [{docType: 'ID_PROOF', requiredCount: 1}, {docType: 'PAYSLIP', requiredCount: 2}]}]" variableName="rules" />
			<set-variable value="#[{applicationId: 'APP-2026-000001', documents: [{status: 'ACCEPTED', sha256: 'a1', sourcePath: 'staging/f/id.pdf', sizeBytes: 100}]}]" variableName="app" />
			<set-variable value="#[{present: [{key: 'staging/f/id.pdf', fileName: 'id.pdf', docType: 'ID_PROOF', size: 100}]}]" variableName="reconciliation" />
			<munit-tools:mock-when processor="mule:flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="sf-validate-file" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{}]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="sf-validate-files" />
