	<munit:config name="custody-test-suite.xml" />
	<munit:test name="matching-count-agrees" description="Declared 2 and 2 found, no checksums: the manifest agrees">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', manifest: {folder: 'f', documentCount: 2, documents: [{fileName: 'id_proof.pdf', 'type': 'ID_PROOF'}, {fileName: 'payslip_1.pdf', 'type': 'PAYSLIP'}]}}]" variableName="app" />
			<set-variable value="#[{present: [{fileName: 'f0.pdf'}, {fileName: 'f1.pdf'}]}]" variableName="reconciliation" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/manifest-check.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.agrees]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that expression="#[payload.declaredCount]" is="#[MunitTools::equalTo(2)]" />
			<munit-tools:assert-that expression="#[payload.foundCount]" is="#[MunitTools::equalTo(2)]" />
		</munit:validation>
	</munit:test>
	<munit:test name="declared-count-above-found-is-a-mismatch" description="Declared 5 but 4 found: MANIFEST_MISMATCH territory (AC6)">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', manifest: {folder: 'f', documentCount: 5, documents: [{fileName: 'id_proof.pdf', 'type': 'ID_PROOF'}, {fileName: 'payslip_1.pdf', 'type': 'PAYSLIP'}]}}]" variableName="app" />
			<set-variable value="#[{present: [{fileName: 'f0.pdf'}, {fileName: 'f1.pdf'}, {fileName: 'f2.pdf'}, {fileName: 'f3.pdf'}]}]" variableName="reconciliation" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/manifest-check.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.agrees]" is="#[MunitTools::equalTo(false)]" />
			<munit-tools:assert-that expression="#[payload.countMatches]" is="#[MunitTools::equalTo(false)]" />
			<munit-tools:assert-that expression="#[payload.declaredCount]" is="#[MunitTools::equalTo(5)]" />
			<munit-tools:assert-that expression="#[payload.foundCount]" is="#[MunitTools::equalTo(4)]" />
		</munit:validation>
	</munit:test>
	<munit:test name="declared-count-below-found-is-a-mismatch" description="Declared 3 but 4 found is also a mismatch">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', manifest: {folder: 'f', documentCount: 3, documents: [{fileName: 'id_proof.pdf', 'type': 'ID_PROOF'}, {fileName: 'payslip_1.pdf', 'type': 'PAYSLIP'}]}}]" variableName="app" />
			<set-variable value="#[{present: [{fileName: 'f0.pdf'}, {fileName: 'f1.pdf'}, {fileName: 'f2.pdf'}, {fileName: 'f3.pdf'}]}]" variableName="reconciliation" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/manifest-check.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.agrees]" is="#[MunitTools::equalTo(false)]" />
		</munit:validation>
	</munit:test>
	<munit:test name="matching-checksum-agrees" description="A declared checksum equal to the computed one passes, whatever the letter case">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', manifest: {folder: 'f', documentCount: 2, documents: [{fileName: 'id_proof.pdf', 'type': 'ID_PROOF', sha256: 'AA'}, {fileName: 'payslip_1.pdf', 'type': 'PAYSLIP'}]}}]" variableName="app" />
			<set-variable value="#[{present: [{fileName: 'f0.pdf'}, {fileName: 'f1.pdf'}]}]" variableName="reconciliation" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/manifest-check.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.agrees]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that expression="#[sizeOf(payload.checksumMismatches)]" is="#[MunitTools::equalTo(0)]" />
		</munit:validation>
	</munit:test>
	<munit:test name="different-checksum-is-a-mismatch" description="A declared checksum that differs from the computed one is reported with both values">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', manifest: {folder: 'f', documentCount: 2, documents: [{fileName: 'id_proof.pdf', 'type': 'ID_PROOF', sha256: 'ff'}, {fileName: 'payslip_1.pdf', 'type': 'PAYSLIP'}]}}]" variableName="app" />
			<set-variable value="#[{present: [{fileName: 'f0.pdf'}, {fileName: 'f1.pdf'}]}]" variableName="reconciliation" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/manifest-check.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.agrees]" is="#[MunitTools::equalTo(false)]" />
			<munit-tools:assert-that expression="#[payload.countMatches]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that expression="#[sizeOf(payload.checksumMismatches)]" is="#[MunitTools::equalTo(1)]" />
			<munit-tools:assert-that expression="#[payload.checksumMismatches[0].fileName]" is="#[MunitTools::equalTo('id_proof.pdf')]" />
			<munit-tools:assert-that expression="#[payload.checksumMismatches[0].declared]" is="#[MunitTools::equalTo('ff')]" />
			<munit-tools:assert-that expression="#[payload.checksumMismatches[0].found]" is="#[MunitTools::equalTo('aa')]" />
		</munit:validation>
	</munit:test>
	<munit:test name="checksum-of-a-rejected-file-is-not-compared" description="A file that was not accepted has no digest to compare, so it is left out">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', manifest: {folder: 'f', documentCount: 2, documents: [{fileName: 'id_proof.pdf', 'type': 'ID_PROOF', sha256: 'ff'}, {fileName: 'payslip_1.pdf', 'type': 'PAYSLIP'}]}}]" variableName="app" />
			<set-variable value="#[{present: [{fileName: 'f0.pdf'}, {fileName: 'f1.pdf'}]}]" variableName="reconciliation" />
			<set-variable value="#[{accepted: [{key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/manifest-check.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.agrees]" is="#[MunitTools::equalTo(true)]" />
		</munit:validation>
	</munit:test>
	<munit:test name="manifest-check-flow-keeps-the-result" description="The flow stores the result for the stage change">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', manifest: {folder: 'f', documentCount: 5, documents: [{fileName: 'id_proof.pdf', 'type': 'ID_PROOF'}, {fileName: 'payslip_1.pdf', 'type': 'PAYSLIP'}]}}]" variableName="app" />
			<set-variable value="#[{present: [{fileName: 'f0.pdf'}, {fileName: 'f1.pdf'}, {fileName: 'f2.pdf'}, {fileName: 'f3.pdf'}]}]" variableName="reconciliation" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
		</munit:behavior>
		<munit:execution>
			<flow-ref name="sf-check-manifest" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.manifestCheck.agrees]" is="#[MunitTools::equalTo(false)]" />
			<munit-tools:assert-that expression="#[vars.manifestCheck.declaredCount]" is="#[MunitTools::equalTo(5)]" />
		</munit:validation>
	</munit:test>
	<munit:test name="custody-inventory-records-source-stored-path-and-digest" description="Every accepted file is saved with where it came from, where it is kept and its digest (FR11)">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', verificationRound: 1, correlationId: '22222222-2222-4222-8222-222222222222'}]" variableName="app" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
			<set-variable value="#[{unexpected: [{fileName: 'n.txt'}]}]" variableName="reconciliation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/custody-inventory.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[sizeOf(payload.documents)]" is="#[MunitTools::equalTo(2)]" />
			<munit-tools:assert-that expression="#[payload.documents[0].sourcePath]" is="#[MunitTools::equalTo('staging/f/id_proof.pdf')]" />
			<munit-tools:assert-that expression="#[payload.documents[0].storedPath]" is="#[MunitTools::equalTo('verified/APP-2026-000001/id_proof.pdf')]" />
			<munit-tools:assert-that expression="#[payload.documents[0].sha256]" is="#[MunitTools::equalTo('aa')]" />
			<munit-tools:assert-that expression="#[payload.documents[0].status]" is="#[MunitTools::equalTo('ACCEPTED')]" />
		</munit:validation>
	</munit:test>
	<munit:test name="verified-stage-body-queues-the-scoring-message" description="The stage change to VERIFIED asks for a SCORE_REQUESTED message and only applies from VERIFYING">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', verificationRound: 1, correlationId: '22222222-2222-4222-8222-222222222222'}]" variableName="app" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
			<set-variable value="#[{unexpected: [{fileName: 'n.txt'}]}]" variableName="reconciliation" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/verified-stage.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.toStage]" is="#[MunitTools::equalTo('VERIFIED')]" />
			<munit-tools:assert-that expression="#[payload.expectedFromStage]" is="#[MunitTools::equalTo('VERIFYING')]" />
			<munit-tools:assert-that expression="#[payload.publish.queue]" is="#[MunitTools::equalTo('loan.score.q')]" />
			<munit-tools:assert-that expression="#[payload.publish.&quot;type&quot;]" is="#[MunitTools::equalTo('SCORE_REQUESTED')]" />
			<munit-tools:assert-that expression="#[payload.detail.accepted]" is="#[MunitTools::equalTo(2)]" />
			<munit-tools:assert-that expression="#[payload.detail.folder]" is="#[MunitTools::equalTo('verified/APP-2026-000001/')]" />
			<munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::equalTo('22222222-2222-4222-8222-222222222222')]" />
		</munit:validation>
	</munit:test>
	<munit:test name="incomplete-stage-body-carries-the-mismatch" description="A manifest mismatch is explained in the audit detail">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', verificationRound: 1, correlationId: '22222222-2222-4222-8222-222222222222', manifest: {folder: 'f'}}]" variableName="app" />
			<set-variable value="MANIFEST_MISMATCH" variableName="incompleteReason" />
			<set-variable value="#[{missingFiles: [], unexpected: []}]" variableName="reconciliation" />
			<set-variable value="#[{missingTypes: [], quarantined: [], duplicates: []}]" variableName="validation" />
			<set-variable value="#[{declaredCount: 5, foundCount: 4, countMatches: false, checksumMismatches: [], agrees: false}]" variableName="manifestCheck" />
		</munit:behavior>
		<munit:execution>
			<ee:transform doc:name="Transform Message"><ee:message><ee:set-payload resource="dwl/incomplete-stage.dwl" /></ee:message></ee:transform>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.reason]" is="#[MunitTools::equalTo('MANIFEST_MISMATCH')]" />
			<munit-tools:assert-that expression="#[payload.detail.mismatch.declaredCount]" is="#[MunitTools::equalTo(5)]" />
			<munit-tools:assert-that expression="#[payload.detail.mismatch.foundCount]" is="#[MunitTools::equalTo(4)]" />
		</munit:validation>
	</munit:test>
	<munit:test name="incomplete-stage-body-has-no-mismatch-for-other-reasons" description="Other reasons carry no mismatch section">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', verificationRound: 1, correlationId: '22222222-2222-4222-8222-222222222222', manifest: {folder: 'f'}}]" variableName="app" />
			<set-variable value="MANIFEST_MISMATCH" variableName="incompleteReason" />
