	<munit:test name="custody-copies-saves-marks-and-removes" description="Each accepted file is copied, the inventory and stage are saved, then the staging copies are removed">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', verificationRound: 1, correlationId: '22222222-2222-4222-8222-222222222222'}]" variableName="app" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
			<set-variable value="#[{unexpected: []}]" variableName="reconciliation" />
			<munit-tools:mock-when processor="s3:copy-object">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Copy to verified" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Save custody inventory" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark verified" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="s3:delete-object">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Remove from staging" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[null]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="sf-take-custody" />
		</munit:execution>
		<munit:validation>
			<munit-tools:verify-call processor="s3:copy-object" times="2">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Copy to verified" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Save custody inventory" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark verified" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="s3:delete-object" times="2">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Remove from staging" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
	<munit:test name="failed-staging-cleanup-does-not-undo-custody" description="If a staging copy cannot be removed the application is still VERIFIED; the verified copy is the record">
		<munit:behavior>
			<set-variable value="#[{applicationId: 'APP-2026-000001', verificationRound: 1, correlationId: '22222222-2222-4222-8222-222222222222'}]" variableName="app" />
			<set-variable value="#[{accepted: [{key: 'staging/f/id_proof.pdf', fileName: 'id_proof.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'aa'}, {key: 'staging/f/payslip_1.pdf', fileName: 'payslip_1.pdf', docType: 'X', size: 100, status: 'ACCEPTED', sha256: 'bb'}]}]" variableName="validation" />
			<set-variable value="#[{unexpected: []}]" variableName="reconciliation" />
			<munit-tools:mock-when processor="s3:copy-object">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Copy to verified" />
