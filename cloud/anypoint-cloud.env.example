# Settings for deploying the loan project to YOUR OWN CloudHub 2.0 and hosted services.
# Copy this file to  %USERPROFILE%\.anypoint-cloud.env  (outside the repository) and fill in every value.
# Never commit the filled-in file. Use your own free accounts; do not reuse anybody else's credentials.
# Lines starting with # are comments. No quotes around values.

# ---- Hosted PostgreSQL (for example neon.tech, free). Use the direct host, not the pooler. Database must exist (create one called loan).
PG_HOST=ep-your-host.us-east-2.aws.neon.tech
PG_PORT=5432
PG_DB=loan
PG_USER=your_db_owner
PG_PASSWORD=

# ---- Hosted RabbitMQ (for example cloudamqp.com "Little Lemur", free). In CloudAMQP the user name equals the virtual host name.
AMQP_HOST=your-instance.rmq.cloudamqp.com
AMQP_PORT=5672
AMQP_VHOST=your_vhost
AMQP_USER=your_vhost
AMQP_PASSWORD=
# Optional. Default is https://<AMQP_HOST>/api
# AMQP_MGMT_URL=

# ---- SMTP that catches mail (for example Mailtrap Email Sandbox, free): Integration > SMTP shows these.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=

# ---- S3-compatible bucket (for example Backblaze B2, free 10 GB). Create the bucket, then an application key limited to it.
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Anypoint Platform (a trial account is enough)
# Organization id: Access Management > Business Groups > your organization.
ANYPOINT_ORG_ID=
# Environment name, usually Sandbox. Its id is looked up automatically.
ANYPOINT_ENV=Sandbox
# Connected App: Access Management > Connected Apps > Create app > "App acts on its own behalf (client credentials)".
# Scopes (for the Sandbox environment): Deploy Applications, Create Applications, Delete Applications, Read Applications,
# Download Application, Manage APIs Configuration, Manage Policies, Create Applications in Exchange (and Exchange Contributor).
ANYPOINT_CLIENT_ID=
ANYPOINT_CLIENT_SECRET=
# The environment's own client id and secret: Access Management > Environments > Sandbox. API autodiscovery uses these.
ENV_CLIENT_ID=
ENV_CLIENT_SECRET=

# ---- Encryption of the cloud secrets
# Any 16 characters. Keeps the secure-cloudhub.yaml values private; it is also given to the apps as the secure property secure.key.
SECURE_KEY_CLOUD=
# Full path of secure-properties-tool.jar (download it from docs.mulesoft.com, "Secure Configuration Properties").
SECURE_PROPS_TOOL=C:\tools\secure-props\secure-properties-tool.jar

# ---- Filled in by the scripts (leave empty)
# CLOUD_SYSTEM_API_URL, CLOUD_INTAKE_API_URL,
# CLOUD_DOCUMENT_URL                            written by:  python scripts/setup-cloud.py urls
# SYSTEM_API_ID, INTAKE_API_ID, DOCUMENT_API_ID written by:  python scripts/setup-cloud.py api-manager
# INTAKE_CLIENT_ID, INTAKE_CLIENT_SECRET,
# INTAKE_APP_ID, DOCUMENT_CONTRACT              written by:  python scripts/setup-cloud.py api-manager
