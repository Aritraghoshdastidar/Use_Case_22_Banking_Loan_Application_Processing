<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<!-- Global error handler. Dependency failures (system API, broker, store, mail server) answer 503, everything else 500.
	     The log line carries the status, the error type and the correlation id only: never the message, the payload or any personal data. -->
	<error-handler name="global-error-handler">
		<on-error-propagate enableNotifications="false" logException="false" doc:name="503" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT, HTTP:SERVICE_UNAVAILABLE, HTTP:BAD_GATEWAY, HTTP:INTERNAL_SERVER_ERROR, AMQP:CONNECTIVITY">
			<set-variable value="503" doc:name="Set httpStatus" variableName="httpStatus" />
			<set-variable value="SERVICE_UNAVAILABLE" doc:name="Set errorCode" variableName="errorCode" />
			<flow-ref doc:name="sf-build-error-response" name="sf-build-error-response" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="false" logException="false" doc:name="500">
			<set-variable value="500" doc:name="Set httpStatus" variableName="httpStatus" />
			<set-variable value="INTERNAL_ERROR" doc:name="Set errorCode" variableName="errorCode" />
			<flow-ref doc:name="sf-build-error-response" name="sf-build-error-response" />
		</on-error-propagate>
	</error-handler>
	<sub-flow name="sf-build-error-response">
		<logger level="ERROR" doc:name="Logger" category="com.loan.scoring.error" message="#['status=' ++ (vars.httpStatus as String) ++ ' code=' ++ vars.errorCode ++ ' errorType=' ++ (error.errorType.namespace default '') ++ ':' ++ (error.errorType.identifier default '') ++ ' correlationId=' ++ correlationId]" />
		<set-variable value="#[{'Content-Type': 'application/json'}]" doc:name="Set outboundHeaders" variableName="outboundHeaders" />
		<ee:transform doc:name="Transform Message">
			<ee:message>
				<ee:set-payload resource="dwl/error-body.dwl" />
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
